# SkillCall model stack — copy to .env and fill to switch models from
# "simulated" (local fallback) to "live". Everything runs without these.

# --- Sarvam AI (STT Saaras, TTS Bulbul, LLM Sarvam-M/30B/105B) ---
SARVAM_API_KEY=
# Optional overrides:
# SARVAM_BASE_URL=https://api.sarvam.ai
# SARVAM_STT_MODEL=saaras:v2.5
# SARVAM_TTS_MODEL=bulbul:v2
# SARVAM_LLM_MODEL=sarvam-m
# SARVAM_TTS_SPEAKER=anushka

# --- AI4Bharat IndicConformer (Indic STT fallback) ---
AI4BHARAT_ENDPOINT=
AI4BHARAT_API_KEY=

# --- feature flags (default on; still require the key above) ---
# SKILLCALL_ENABLE_LLM=true
# SKILLCALL_ENABLE_TTS=true
# SKILLCALL_ENABLE_STT=true

# --- telephony (declared in architecture; not called in prototype) ---
# SKILLCALL_TELEPHONY=exotel
